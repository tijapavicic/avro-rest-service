{
  "name": "sim-engine-frontend",
  "version": "0.0.1",
  "description": "Web Components frontend for sim-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx serve . -l 3000",
    "serve": "npx serve . -l 3000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/*.test.js --testPathIgnorePatterns=integration",
    "test:integration": "jest tests/integration.test.js",
    "test:verbose": "jest --verbose"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/dom": "^9.3.0",
    "@testing-library/jest-dom": "^6.1.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}

